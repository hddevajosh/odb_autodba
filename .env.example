# =========================================
# Oracle Default Connection
# =========================================

ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=system
ORACLE_PASSWORD=your_password_here

# Optional SID / PDB
ORACLE_SID=
ORACLE_PDB=
# Optional compatibility name used by current config parser
ORACLE_PDB_NAME=

# Optional advanced connection settings
ORACLE_CDB_NAME=
ORACLE_DSN=
ORACLE_SYSDBA=false
ODB_AUTODBA_ENVIRONMENT=default

# =========================================
# MCP Configuration
# =========================================

ODB_AUTODBA_USE_MCP=true
ODB_AUTODBA_MCP_BASE_URL=http://127.0.0.1:8000
ODB_AUTODBA_MCP_FALLBACK_LOCAL=true

ODB_AUTODBA_MCP_HOST=127.0.0.1
ODB_AUTODBA_MCP_PORT=8000

# =========================================
# Gradio UI
# =========================================

ODB_AUTODBA_GRADIO_HOST=127.0.0.1
ODB_AUTODBA_GRADIO_PORT=7860

# =========================================
# Job Queue Limits
# =========================================

ODB_AUTODBA_MAX_HEALTH_JOBS=5
ODB_AUTODBA_MAX_HISTORY_JOBS=2
ODB_AUTODBA_MAX_INVESTIGATION_JOBS=2
ODB_AUTODBA_MAX_TOTAL_JOBS=10
# Optional: active session jobs (defaults to health job limit if unset)
ODB_AUTODBA_MAX_SESSIONS_JOBS=5
# Optional: per-db running cap (defaults to total cap if unset)
ODB_AUTODBA_MAX_JOBS_PER_DB=10

# =========================================
# Job Timeouts
# =========================================

ODB_AUTODBA_JOB_TIMEOUT_SECONDS=600
ODB_AUTODBA_INVESTIGATION_TIMEOUT_SECONDS=300
ODB_AUTODBA_HISTORY_TIMEOUT_SECONDS=600

# =========================================
# Job Retention
# =========================================

ODB_AUTODBA_JOB_RETENTION_HOURS=72
ODB_AUTODBA_JOB_CLEANUP_ON_START=true

# =========================================
# Deduplication
# =========================================

ODB_AUTODBA_DEDUP_JOBS=true
ODB_AUTODBA_DEDUP_WINDOW_SECONDS=60

# =========================================
# Host Check Mode
# =========================================

ODB_AUTODBA_HOST_CHECK_MODE=local_app_host

# SSH Mode (optional)
ODB_AUTODBA_SSH_HOST=
ODB_AUTODBA_SSH_PORT=22
ODB_AUTODBA_SSH_USER=
ODB_AUTODBA_SSH_KEY_FILE=
ODB_AUTODBA_SSH_TIMEOUT_SECONDS=10

# =========================================
# AI / LLM (optional)
# =========================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
